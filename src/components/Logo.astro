  <svg class="h-7 w-7" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="var(--aw-color-primary)"></rect>
    <path d="M10 25V8h12v17" fill="none" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"></path>
    <circle cx="18.5" cy="17" r="1.6" fill="#fff"></circle>
  </svg>
  {SITE?.name}
