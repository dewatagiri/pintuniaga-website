---
import { Icon } from 'astro-icon/components';
import { WHATSAPP_HREF } from '~/utils/contact';
---

{
  WHATSAPP_HREF && (
    <a
      href={WHATSAPP_HREF}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hubungi kami di WhatsApp"
      class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:scale-105 focus:outline-none focus:ring-4 focus:ring-green-300"
    >
      <Icon name="tabler:brand-whatsapp" class="h-8 w-8" />
    </a>
  )
}
