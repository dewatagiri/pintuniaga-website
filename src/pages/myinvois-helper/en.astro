---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { EMAIL, EMAIL_HREF } from '~/utils/contact';

const GITHUB_URL = 'https://github.com/dewatagiri/myinvois-helper';
const MCP_URL = 'https://myinvois-helper.onrender.com/mcp';

const metadata = {
  title: 'MyInvois Helper (English) — Free LHDN e-Invoice Helper',
  description:
    'MyInvois Helper is a free AI connector that checks e-invoicing requirements, looks up LHDN classification codes and drafts invoices with SST. Test it in 10 minutes.',
};

const steps = [
  { title: 'Open Claude', description: 'Use Claude on the web or the desktop app.' },
  { title: 'Go to Settings → Connectors', description: 'Open Settings, then choose Connectors.' },
  { title: 'Click "Add custom connector"', description: 'Choose to add a new connector manually.' },
  {
    title: 'Paste the server URL',
    description: 'Enter the address below as the connector URL, then save. No sign-in is required.',
    code: MCP_URL,
  },
  {
    title: 'Run the test prompts below',
    description: 'Start a new chat, make sure the connector is enabled, and paste a prompt.',
  },
];

const tests = [
  {
    title: 'Test 1 — Is e-invoicing required?',
    prompt:
      'My food and beverage business sells to walk-in customers and had RM2,500,000 turnover last year. Do I need to issue e-invoices, and from when?',
    expect: [
      'Calls the "check e-invoice obligation" tool.',
      'Says e-invoicing is mandatory, Phase 4, starting 1 January 2026 (turnover above RM1 million, so not exempt).',
      'Notes that a single transaction above RM10,000 needs its own e-invoice, and that walk-in sales can go in one monthly consolidated e-invoice (buyer TIN EI00000000010).',
      'Ends with a note that this is general guidance and to confirm with LHDN.',
    ],
  },
  {
    title: 'Test 2 — Classification code lookup',
    prompt: 'Which LHDN e-invoice classification code and tax type should I use for a laptop?',
    expect: [
      'Calls the "classification code lookup" tool.',
      'Returns code 003 — "Computer, smartphone or tablet".',
      'Lists the tax type codes (01 Sales Tax, 02 Service Tax, 03 Tourism Tax, 04 High-Value Goods Tax, 05 Sales Tax on Low Value Goods, 06 Not Applicable, E Exempt).',
    ],
  },
  {
    title: 'Test 3 — Draft an invoice with SST',
    prompt:
      'Draft an e-invoice dated 2026-10-03 from Kedai Contoh Sdn Bhd to a walk-in customer for 1 web design service at RM1,000 with 8% service tax. Tell me what is missing before it can be submitted.',
    expect: [
      'Calls the "draft e-invoice" tool.',
      'Totals: RM1,000.00 excluding tax, RM80.00 service tax (type 02, 8%), RM1,080.00 payable.',
      'Buyer filled in as "General Public" with TIN EI00000000010.',
      'Readiness checklist says the draft is NOT ready, listing missing supplier TIN, BRN, MSIC, activity, address, phone and the invoice number.',
      'Classification may fall back to 022 (Others) because it is unclear — it asks you to confirm.',
      'States clearly that nothing was submitted to LHDN.',
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Free e-invoice helper · English"
    actions={[
      { variant: 'primary', text: 'How to connect', href: '#connect' },
      { text: 'Bahasa Melayu', href: getPermalink('/myinvois-helper') },
    ]}
  >
    <Fragment slot="title">
      MyInvois Helper: <span class="text-primary">LHDN e-invoicing</span> made easier
    </Fragment>
    <Fragment slot="subtitle">
      A free connector for Claude. Test it in about 10 minutes — no prior knowledge needed.
    </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto">
    <div class="rounded-2xl border border-amber-300 bg-amber-50 p-6 md:p-8 flex gap-4 items-start">
      <Icon name="tabler:info-circle" class="w-7 h-7 shrink-0 text-amber-600" />
      <div>
        <h2 class="text-xl font-bold mb-2">What it is</h2>
        <p class="text-muted">
          MyInvois Helper is a free connector that lets an AI assistant such as Claude help Malaysian businesses with
          LHDN e-invoicing (MyInvois). No account or sign-in is needed. It only prepares <strong>drafts</strong>: it
          does
          <strong>not submit anything to LHDN</strong> and does <strong>not store your data</strong>. It is an
          independent tool by PintuNiaga and is <strong>not affiliated with LHDN</strong>. It gives guidance, not tax
          advice.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <Features
    tagline="The three tools"
    title="What it can do"
    columns={3}
    items={[
      {
        title: 'Check if e-invoicing is required',
        description:
          'Give your annual turnover and it tells you whether e-invoicing is mandatory, which phase you are in, and when it starts.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Classification code / tax type lookup',
        description:
          'Describe an item in plain words (e.g. "laptop") and get the matching LHDN classification code and tax types.',
        icon: 'tabler:tags',
      },
      {
        title: 'Draft invoice with SST and checklist',
        description: 'Builds a draft invoice with SST totals and lists the mandatory fields that are still missing.',
        icon: 'tabler:file-invoice',
      },
    ]}
  />

  <WidgetWrapper id="connect" containerClass="max-w-4xl mx-auto">
    <Headline
      tagline="Step 1"
      title="Connect it to Claude"
      subtitle="Claude → Settings → Connectors → Add custom connector."
    />
    <ol class="space-y-6">
      {
        steps.map((step, index) => (
          <li class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-white font-bold">
              {index + 1}
            </span>
            <div class="min-w-0 pt-1.5">
              <h3 class="text-lg font-bold">{step.title}</h3>
              <p class="text-muted mt-1">{step.description}</p>
              {step.code && (
                <code class="mt-3 block break-all rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm font-mono select-all">
                  {step.code}
                </code>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm">
      <strong>Note:</strong> The server sleeps when idle; the first request can take up to a minute.
    </p>
  </WidgetWrapper>

  <WidgetWrapper id="test" containerClass="max-w-4xl mx-auto">
    <Headline
      tagline="Step 2"
      title="Three test prompts"
      subtitle="Copy each prompt into Claude and compare with what a correct answer includes."
    />
    <div class="space-y-8">
      {
        tests.map((t) => (
          <div class="rounded-2xl border border-gray-200 p-6">
            <h3 class="text-lg font-bold">{t.title}</h3>
            <p class="mt-3 text-sm font-semibold">Prompt (copy and paste):</p>
            <code class="mt-1 block rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm select-all whitespace-pre-wrap">
              {t.prompt}
            </code>
            <p class="mt-4 text-sm font-semibold">A correct answer includes:</p>
            <ul class="mt-1 list-disc pl-5 space-y-1 text-muted">
              {t.expect.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">
      Rules are as of October 2026. Wording will vary; the figures and codes above should match.
    </p>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-4xl mx-auto">
    <p class="text-center text-sm text-muted">
      <a class="text-primary underline" href={getPermalink('/privasi')}>Privacy</a> ·
      <a class="text-primary underline" href={getPermalink('/terma')}>Terms</a> · Support:
      <a class="text-primary underline" href={EMAIL_HREF}>{EMAIL}</a> ·
      <a class="text-primary underline" href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
    </p>
    <p class="mt-2 text-center text-xs text-muted">The Privacy and Terms pages are in Bahasa Melayu.</p>
  </WidgetWrapper>
</Layout>
