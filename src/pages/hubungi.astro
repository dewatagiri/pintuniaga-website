---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';
import { EMAIL, EMAIL_HREF, WHATSAPP_HREF } from '~/utils/contact';

const metadata = {
  title: 'Hubungi',
  description: 'Hubungi PintuNiaga untuk automasi AI, setup e-Invois LHDN, automasi WhatsApp serta laman web & SEO.',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-3xl mx-auto">
    <Headline
      tagline="Get in touch"
      title="Hubungi Kami"
      subtitle="Ada soalan atau ingin mula mengautomasikan perniagaan anda? Kami sedia membantu."
      classes={{ title: 'text-4xl md:text-5xl font-bold font-heading' }}
    />
    <div class="grid gap-4">
      <a
        href={EMAIL_HREF}
        class="flex items-center gap-4 rounded-2xl border border-gray-200 p-5 md:p-6 transition hover:border-primary hover:shadow-md"
      >
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
          <Icon name="tabler:mail" class="w-6 h-6" />
        </span>
        <span class="min-w-0">
          <span class="block text-sm text-muted">Emel</span>
          <span class="block text-lg font-semibold break-all">{EMAIL}</span>
        </span>
      </a>
      {
        WHATSAPP_HREF && (
          <a
            href={WHATSAPP_HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 rounded-2xl border border-gray-200 p-5 md:p-6 transition hover:border-primary hover:shadow-md"
          >
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#25D366]/15 text-[#128C7E]">
              <Icon name="tabler:brand-whatsapp" class="w-6 h-6" />
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-muted">WhatsApp</span>
              <span class="block text-lg font-semibold">Mesej kami di WhatsApp</span>
            </span>
          </a>
        )
      }
    </div>
  </WidgetWrapper>

  <WidgetWrapper id="keselamatan" containerClass="max-w-3xl mx-auto">
    <div class="rounded-2xl border border-gray-200 p-6 md:p-8 flex gap-4 items-start">
      <Icon name="tabler:shield-lock" class="w-7 h-7 shrink-0 text-primary" />
      <div>
        <h2 class="text-xl font-bold mb-2">Laporkan masalah keselamatan</h2>
        <p class="text-muted">
          Jumpa masalah keselamatan pada pintuniaga.my atau MyInvois Helper? Sila emel <a
            class="text-primary underline break-all"
            href={`${EMAIL_HREF}?subject=SECURITY`}>{EMAIL}</a
          > dengan subjek <strong>SECURITY</strong>. Kami berusaha membalas dalam masa <strong>5 hari bekerja</strong>.
          Sila jangan dedahkan masalah tersebut kepada umum sehingga ia dibaiki.
        </p>
        <p class="text-muted mt-2 text-sm">
          To report a security issue, email us with the subject "SECURITY". We aim to reply within 5 working days.
          Please do not disclose it publicly before it is fixed.
        </p>
      </div>
    </div>
  </WidgetWrapper>
</Layout>
